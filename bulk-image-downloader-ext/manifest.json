{
  "manifest_version": 3,
  "name": "PixGrab – Bulk Image Downloader",
  "short_name": "PixGrab",
  "version": "2.2.0",
  "description": "Scan any webpage and download PNG, JPG, or WebP images at once, auto-cropped/resized to at least 512\u00d7512 with an aspect ratio up to 3:1. Filter by format or size, convert to JPG, and save exactly where you want.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PixGrab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
