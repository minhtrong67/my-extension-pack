{
  "manifest_version": 3,
  "name": "TubeShot - YouTube Screenshot",
  "short_name": "TubeShot",
  "description": "Capture clean, control-free frames from any YouTube video at the exact moment you want, with optional timestamp and caption overlays. Chụp ảnh khung hình YouTube chuẩn xác, sạch giao diện.",
  "version": "1.0.0",
  "author": "gnort67",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TubeShot"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "downloads"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "default_locale": "en"
}
