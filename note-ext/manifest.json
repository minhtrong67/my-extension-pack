{
  "manifest_version": 3,
  "name": "Ghi Chú / QuickNote",
  "version": "2.0.0",
  "description": "Ghi chú nhanh, riêng tư, theo phong cách Material Design 3 | A fast, private note-taking extension styled with Material Design 3",
  "author": "gnort67",

  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickNote",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": ["storage"],

  "commands": {
    "_execute_action": {
      "description": "Mở QuickNote / Open QuickNote"
    }
  }
}
