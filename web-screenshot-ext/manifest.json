{
  "manifest_version": 3,
  "name": "SmartShot - Screenshot & Annotate",
  "short_name": "SmartShot",
  "description": "Capture visible area, full page, or a selected region, then annotate with drawings, arrows, text, and blur. Chụp và chú thích ảnh chụp màn hình thông minh.",
  "version": "1.0.0",
  "author": "gnort67",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SmartShot"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": ["activeTab", "scripting", "tabs", "downloads", "storage", "offscreen"],
  "default_locale": "en"
}
