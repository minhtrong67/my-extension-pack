{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "PixFlip",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "author": "gnort67",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PixFlip"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": ["contextMenus", "downloads", "storage", "offscreen", "notifications"],
  "host_permissions": ["<all_urls>"],
  "default_locale": "en"
}
